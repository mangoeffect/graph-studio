{
  "version": "2.0",
  "_comment": "model_path carries the model NAME only; the host-registered ModelFinder (task_graph::set_model_finder) maps it to a file path at runtime. Without a finder it falls back to _source_dir-relative resolution (see include/task_graph/path_utils.hpp).",
  "tasks": [
    {
      "id": "image_src",
      "type": "opencv_image_read",
      "params": {
        "file_path": "../../models/mediapipe/portrait.jpg"
      }
    },
    {
      "id": "segmenter",
      "type": "mp_image_segmenter",
      "params": {
        "model_path": "image_segmenter.tflite",
        "delegate": 0,
        "running_mode": 1,
        "output_confidence_masks": true,
        "output_category_mask": false
      }
    }
  ],
  "edges": [
    {
      "from": "image_src",
      "from_port": "out",
      "to": "segmenter",
      "to_port": "image"
    }
  ]
}
