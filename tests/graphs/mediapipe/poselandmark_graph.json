{
  "version": "2.0",
  "_comment": "model_path carries the model NAME only; the host-registered ModelFinder (task_graph::set_model_finder) maps it to a file path at runtime. Without a finder it falls back to _source_dir-relative resolution (see include/task_graph/path_utils.hpp).",
  "tasks": [
    {
      "id": "image_src",
      "type": "opencv_image_read",
      "params": {
        "file_path": "../../models/mediapipe/portrait.jpg"
      }
    },
    {
      "id": "pose_landmarker",
      "type": "mp_pose_landmarker",
      "params": {
        "model_path": "pose_landmarker.task",
        "delegate": 0,
        "running_mode": 1,
        "num_poses": 1,
        "min_pose_detection_confidence": 0.5,
        "min_pose_presence_confidence": 0.5,
        "min_tracking_confidence": 0.5,
        "output_segmentation_masks": true
      }
    }
  ],
  "edges": [
    {
      "from": "image_src",
      "from_port": "out",
      "to": "pose_landmarker",
      "to_port": "image"
    }
  ]
}
